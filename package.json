{
  "name": "flujario",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "react-router dev --host 127.0.0.1",
    "build": "react-router build",
    "preview": "wrangler dev",
    "typecheck": "react-router typegen && tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply flujario-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply flujario-db --remote",
    "deploy": "npm run check && wrangler deploy",
    "assets:statements": "node tools/prepare-statement-assets.mjs",
    "predev": "npm run assets:statements",
    "prebuild": "npm run assets:statements",
    "postinstall": "npm run assets:statements"
  },
  "dependencies": {
    "@clerk/localizations": "^4.24.7",
    "@clerk/react-router": "^3.7.1",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/inter-tight": "^5.2.8",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "@tesseract.js-data/spa": "1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.4",
    "fast-xml-parser": "5.12.1",
    "lucide-react": "^0.468.0",
    "papaparse": "5.7.1",
    "pdfjs-dist": "6.5.438",
    "react": "~19.2.7",
    "react-dom": "~19.2.7",
    "react-router": "8.5.1",
    "tailwind-merge": "^3.4.0",
    "tesseract.js": "7.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.1.12"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.69.1",
    "@cloudflare/workers-types": "^5.20261113.1",
    "@react-router/dev": "8.5.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.10.0",
    "@types/papaparse": "5.5.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "drizzle-kit": "0.31.11",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9.3",
    "vite": "^8.0.0",
    "vitest": "^5.1.0",
    "wrangler": "^4.162.0"
  }
}
