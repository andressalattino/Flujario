      "checkConstraints": {
        "entry_amount": {
          "name": "entry_amount",
          "value": "typeof(\"entries\".\"amount_cents\") = 'integer' AND \"entries\".\"amount_cents\" > 0 AND \"entries\".\"amount_cents\" <= 1000000000000"
        },
        "entry_kind": {
          "name": "entry_kind",
          "value": "\"entries\".\"kind\" IN ('income','expense','transfer','exchange')"
        },
        "transfer_accounts": {
          "name": "transfer_accounts",
          "value": "(\"entries\".\"kind\" IN ('income','expense') AND \"entries\".\"target_account_id\" IS NULL AND \"entries\".\"target_currency\" IS NULL AND \"entries\".\"target_amount_minor\" IS NULL AND \"entries\".\"exchange_rate\" IS NULL AND \"entries\".\"exchange_quote_id\" IS NULL)\n        OR (\"entries\".\"kind\" = 'transfer' AND \"entries\".\"target_account_id\" IS NOT NULL AND \"entries\".\"target_account_id\" <> \"entries\".\"account_id\" AND \"entries\".\"target_currency\" = \"entries\".\"currency\" AND \"entries\".\"target_currency\" IS NOT NULL AND \"entries\".\"target_amount_minor\" = \"entries\".\"amount_cents\" AND \"entries\".\"target_amount_minor\" IS NOT NULL AND \"entries\".\"exchange_rate\" IS NULL AND \"entries\".\"exchange_quote_id\" IS NULL)\n        OR (\"entries\".\"kind\" = 'exchange' AND \"entries\".\"target_account_id\" IS NOT NULL AND \"entries\".\"target_account_id\" <> \"entries\".\"account_id\" AND \"entries\".\"target_currency\" IS NOT NULL AND \"entries\".\"target_currency\" <> \"entries\".\"currency\" AND typeof(\"entries\".\"target_amount_minor\") = 'integer' AND \"entries\".\"target_amount_minor\" > 0 AND \"entries\".\"target_amount_minor\" <= 1000000000000 AND \"entries\".\"exchange_rate\" IS NOT NULL)"
        },
        "exchange_rate_text": {
          "name": "exchange_rate_text",
          "value": "\"entries\".\"exchange_rate\" IS NULL OR (typeof(\"entries\".\"exchange_rate\") = 'text' AND length(\"entries\".\"exchange_rate\") BETWEEN 1 AND 21 AND \"entries\".\"exchange_rate\" GLOB '[0-9]*' AND \"entries\".\"exchange_rate\" NOT GLOB '*[^0-9.]*' AND length(\"entries\".\"exchange_rate\") - length(replace(\"entries\".\"exchange_rate\",'.','')) <= 1 AND \"entries\".\"exchange_rate\" NOT LIKE '%.' AND length(replace(replace(\"entries\".\"exchange_rate\",'0',''),'.','')) > 0)"
        },
        "paid_is_expense": {
          "name": "paid_is_expense",
          "value": "\"entries\".\"occurrence_id\" IS NULL OR \"entries\".\"kind\" = 'expense'"
        }
      }
